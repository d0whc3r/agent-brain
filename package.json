{
  "name": "agent-brain",
  "version": "0.3.0",
  "private": true,
  "bin": {
    "brain": "./bin/brain.mjs"
  },
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint --deny-warnings && oxfmt --check && node --test && node bin/brain.mjs mcp check && node bin/brain.mjs premise check && node bin/brain.mjs skills check && bash scripts/check-layout.sh && bash scripts/check-skills.sh && bash scripts/check-paths.sh && bash scripts/check-snippets.sh",
    "skills:check": "node bin/brain.mjs skills check",
    "skills:drift": "node bin/brain.mjs workspace check",
    "skills:update": "node bin/brain.mjs skills sync && bash scripts/sync-references.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
